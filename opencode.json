{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-8",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "planner-to-screen",
  "provider": {
    "anthropic": {}
  },
  "plugin": [
    "opencode-claude-auth@latest",
    "file://./.opencode/plugins/uos.ts"
  ],
  "permission": {
    "edit": "allow",
    "bash": "ask",
    "write": "allow",
    "webfetch": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  }
}
