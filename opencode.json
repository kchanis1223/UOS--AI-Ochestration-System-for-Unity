{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-4-8",
  "small_model": "anthropic/claude-haiku-4-5",
  "default_agent": "ochestrator",
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "provider": {
    "anthropic": {}
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "rg *": "allow",
      "rg": "allow",
      "Get-ChildItem *": "allow",
      "Get-Content *": "allow",
      "Select-String *": "allow",
      "Test-Path *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "bun test*": "allow",
      "bun run test*": "allow",
      "node --version": "allow",
      "bun --version": "allow",
      "opencode --version": "allow",
      "uos doctor*": "allow",
      "uos projects*": "allow",
      "uos context*": "allow",
      "uos ready*": "allow",
      "*": "ask"
    },
    "write": "allow",
    "webfetch": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow"
  }
}
